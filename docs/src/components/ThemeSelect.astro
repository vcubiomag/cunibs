---
import { Icon } from '@astrojs/starlight/components';

const instanceSymbol = Symbol.for('cunibs-theme-select-index');
const locals = Astro.locals as App.Locals & { [instanceSymbol]?: number };
const index = locals[instanceSymbol] ?? 0;
locals[instanceSymbol] = index + 1;
const menuId = `cunibs-theme-menu-${index}`;

const options = [
	{ value: 'light', label: Astro.locals.t('themeSelect.light'), icon: 'sun' },
	{ value: 'dark', label: Astro.locals.t('themeSelect.dark'), icon: 'moon' },
	{ value: 'auto', label: Astro.locals.t('themeSelect.auto'), icon: 'laptop' },
] as const;
---

<theme-select data-choice="auto">
	<button
		type="button"
		class="trigger"
		popovertarget={menuId}
		aria-haspopup="menu"
		aria-label={Astro.locals.t('themeSelect.accessibleLabel')}
	>
		{options.map(({ value, icon }) => <Icon name={icon} size="1.25rem" class={`trigger-icon-${value}`} />)}
	</button>
	<div id={menuId} class="menu" popover role="menu">
		{
			options.map(({ value, label, icon }) => (
				<button type="button" class="item" role="menuitemradio" aria-checked="false" data-value={value}>
					<Icon name={icon} />
					<span class="item-label">{label}</span>
					<Icon name="approve-check" class="check" />
				</button>
			))
		}
	</div>
</theme-select>

<script>
	type Theme = 'auto' | 'dark' | 'light';

	// Starlight's ThemeProvider reads this key before first paint.
	const STORAGE_KEY = 'starlight-theme';
	const MENU_OFFSET_PX = 6;
	const lightScheme = matchMedia('(prefers-color-scheme: light)');

	const parseTheme = (value: unknown): Theme =>
		value === 'dark' || value === 'light' ? value : 'auto';

	function loadTheme(): Theme {
		try {
			return parseTheme(localStorage.getItem(STORAGE_KEY));
		} catch {
			return 'auto';
		}
	}

	function storeTheme(theme: Theme) {
		try {
			localStorage.setItem(STORAGE_KEY, theme === 'auto' ? '' : theme);
		} catch {}
	}

	function applyTheme(theme: Theme) {
		const resolved = theme === 'auto' ? (lightScheme.matches ? 'light' : 'dark') : theme;
		document.documentElement.dataset.theme = resolved;
		document.querySelectorAll<ThemeSelect>('theme-select').forEach((picker) => {
			picker.choice = theme;
		});
	}

	lightScheme.addEventListener('change', () => {
		if (loadTheme() === 'auto') applyTheme('auto');
	});

	class ThemeSelect extends HTMLElement {
		#trigger = this.querySelector<HTMLButtonElement>('.trigger')!;
		#menu = this.querySelector<HTMLElement>('.menu')!;
		#items = [...this.querySelectorAll<HTMLButtonElement>('.item')];

		set choice(theme: Theme) {
			this.dataset.choice = theme;
			for (const item of this.#items) {
				item.setAttribute('aria-checked', String(item.dataset.value === theme));
			}
		}

		connectedCallback() {
			this.choice = loadTheme();

			this.#menu.addEventListener('beforetoggle', (event) => {
				if ((event as ToggleEvent).newState === 'open') this.#position();
			});
			this.#menu.addEventListener('toggle', (event) => {
				if ((event as ToggleEvent).newState !== 'open') return;
				const checked = this.#items.find((item) => item.getAttribute('aria-checked') === 'true');
				(checked ?? this.#items[0])?.focus();
			});
			this.#menu.addEventListener('keydown', (event) => this.#onKeydown(event));

			for (const item of this.#items) {
				item.addEventListener('click', () => {
					const theme = parseTheme(item.dataset.value);
					storeTheme(theme);
					applyTheme(theme);
					this.#menu.hidePopover();
					this.#trigger.focus();
				});
			}

			addEventListener('resize', () => {
				if (this.#menu.matches(':popover-open')) this.#menu.hidePopover();
			});
		}

		#position() {
			const rect = this.#trigger.getBoundingClientRect();
			const { clientWidth, clientHeight } = document.documentElement;
			const isRtl = getComputedStyle(this).direction === 'rtl';
			const opensUp = rect.top > clientHeight / 2;
			const { style } = this.#menu;
			style.top = opensUp ? 'auto' : `${rect.bottom + MENU_OFFSET_PX}px`;
			style.bottom = opensUp ? `${clientHeight - rect.top + MENU_OFFSET_PX}px` : 'auto';
			style.left = isRtl ? `${rect.left}px` : 'auto';
			style.right = isRtl ? 'auto' : `${clientWidth - rect.right}px`;
			this.toggleAttribute('data-opens-up', opensUp);
		}

		#onKeydown(event: KeyboardEvent) {
			const current = this.#items.indexOf(document.activeElement as HTMLButtonElement);
			const last = this.#items.length - 1;
			const targets: Record<string, number> = {
				ArrowDown: current >= last ? 0 : current + 1,
				ArrowUp: current <= 0 ? last : current - 1,
				Home: 0,
				End: last,
			};
			const next = targets[event.key];
			if (next === undefined) return;
			event.preventDefault();
			this.#items[next]?.focus();
		}
	}

	customElements.define('theme-select', ThemeSelect);
</script>

<style>
	@layer cunibs {
		theme-select {
			display: inline-flex;
		}

		.trigger {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: var(--cunibs-control-height);
			height: var(--cunibs-control-height);
			padding: 0;
			border: 0;
			border-radius: var(--cunibs-radius);
			background-color: transparent;
			color: var(--sl-color-gray-2);
			cursor: pointer;
			transition: background-color var(--cunibs-duration-fast) ease-out;
		}
		.trigger:hover,
		.trigger:has(+ :popover-open) {
			background-color: var(--cunibs-fill-hover);
			color: var(--sl-color-white);
		}
		.trigger:focus-visible,
		.item:focus-visible {
			outline: 2px solid var(--sl-color-accent);
			outline-offset: -2px;
		}

		theme-select:not([data-choice='light']) .trigger-icon-light,
		theme-select:not([data-choice='dark']) .trigger-icon-dark,
		theme-select:not([data-choice='auto']) .trigger-icon-auto {
			display: none;
		}

		.menu {
			position: fixed;
			inset: auto;
			min-width: 9.5rem;
			margin: 0;
			padding: 0.25rem;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: var(--cunibs-radius-card);
			background-color: var(--cunibs-surface-raised);
			color: var(--sl-color-gray-2);
			box-shadow: var(--sl-shadow-md);
			--enter-offset: -0.25rem;
		}
		theme-select[data-opens-up] .menu {
			--enter-offset: 0.25rem;
		}
		@media (prefers-reduced-motion: no-preference) {
			.menu {
				transition:
					opacity var(--cunibs-duration-base) ease-out,
					translate var(--cunibs-duration-base) ease-out,
					overlay var(--cunibs-duration-base) allow-discrete,
					display var(--cunibs-duration-base) allow-discrete;
			}
			.menu:not(:popover-open) {
				opacity: 0;
				translate: 0 var(--enter-offset);
			}
			@starting-style {
				.menu:popover-open {
					opacity: 0;
					translate: 0 var(--enter-offset);
				}
			}
		}

		.item {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			width: 100%;
			height: var(--cunibs-control-height);
			padding-inline: 0.5rem;
			border: 0;
			border-radius: var(--cunibs-radius);
			background-color: transparent;
			color: inherit;
			font: inherit;
			font-size: var(--sl-text-sm);
			text-align: start;
			cursor: pointer;
		}
		.item:hover,
		.item:focus-visible {
			background-color: var(--cunibs-fill-hover);
			color: var(--sl-color-white);
		}
		.item[aria-checked='true'] {
			color: var(--sl-color-white);
		}

		.item-label {
			flex: 1;
		}

		.check {
			visibility: hidden;
		}
		.item[aria-checked='true'] .check {
			visibility: visible;
		}
	}
</style>
