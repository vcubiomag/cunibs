---
import { Icon } from '@astrojs/starlight/components';
import { currentTrail } from '../lib/sidebar';

const { entry, sidebar } = Astro.locals.starlightRoute;
const { title } = entry.data;
const trail = currentTrail(sidebar);
const markdown = entry.body ? `# ${title}\n\n${entry.body.trim()}\n` : undefined;
---

<header>
	{
		trail.length > 0 && (
			<nav aria-label="Breadcrumb" data-pagefind-ignore>
				<ol class="breadcrumbs">
					{trail.map((label) => (
						<li>{label}</li>
					))}
				</ol>
			</nav>
		)
	}
	<div class="title-row">
		{/* Starlight's table of contents looks up the page title by this exact id. */}
		<h1 id="_top">{title}</h1>
		{
			markdown && (
				<copy-page data-markdown={markdown} data-pagefind-ignore>
					<button type="button">
						<Icon name="document" class="icon-idle" />
						<Icon name="approve-check" class="icon-done" />
						<span data-label>Copy page</span>
					</button>
					<span class="sr-only" role="status" data-status />
				</copy-page>
			)
		}
	</div>
</header>

<script>
	const RESET_DELAY_MS = 2000;

	class CopyPage extends HTMLElement {
		#timer: ReturnType<typeof setTimeout> | undefined;

		connectedCallback() {
			this.querySelector('button')?.addEventListener('click', () => this.#copy());
		}

		async #copy() {
			const label = this.querySelector('[data-label]');
			const status = this.querySelector('[data-status]');
			try {
				await navigator.clipboard.writeText(this.dataset.markdown ?? '');
			} catch {
				if (status) status.textContent = 'Copy failed';
				return;
			}
			this.toggleAttribute('data-copied', true);
			if (label) label.textContent = 'Copied';
			if (status) status.textContent = 'Page copied as Markdown';
			clearTimeout(this.#timer);
			this.#timer = setTimeout(() => {
				this.removeAttribute('data-copied');
				if (label) label.textContent = 'Copy page';
				if (status) status.textContent = '';
			}, RESET_DELAY_MS);
		}
	}

	customElements.define('copy-page', CopyPage);
</script>

<style>
	@layer cunibs {
		header {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}

		.breadcrumbs {
			display: flex;
			flex-wrap: wrap;
			gap: 0.375rem;
			margin: 0;
			padding: 0;
			list-style: none;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.breadcrumbs li + li::before {
			content: '/';
			margin-inline-end: 0.375rem;
			color: var(--sl-color-gray-4);
		}

		.title-row {
			display: flex;
			align-items: center;
			flex-wrap: wrap;
			justify-content: space-between;
			gap: 0.75rem 1rem;
		}

		h1 {
			min-width: 0;
			margin: 0;
			font-size: var(--sl-text-h1);
			font-weight: 600;
			line-height: var(--sl-line-height-headings);
			letter-spacing: -0.015em;
			color: var(--sl-color-white);
		}

		copy-page {
			flex-shrink: 0;
		}

		copy-page button {
			display: inline-flex;
			align-items: center;
			gap: 0.375rem;
			height: var(--cunibs-control-height);
			padding-inline: 0.625rem 0.75rem;
			border: 1px solid var(--sl-color-hairline-light);
			border-radius: var(--cunibs-radius);
			background-color: transparent;
			color: var(--sl-color-gray-2);
			font: inherit;
			font-size: var(--sl-text-sm);
			cursor: pointer;
			transition: background-color var(--cunibs-duration-fast) ease-out;
		}
		copy-page button:hover {
			background-color: var(--cunibs-fill-hover);
			color: var(--sl-color-white);
		}
		copy-page button:focus-visible {
			outline: 2px solid var(--sl-color-accent);
			outline-offset: 2px;
		}

		copy-page .icon-done,
		copy-page[data-copied] .icon-idle {
			display: none;
		}
		copy-page[data-copied] .icon-done {
			display: block;
		}
	}
</style>
